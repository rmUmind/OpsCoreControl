<Window x:Class="OpsCoreControl.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" Height="450" Width="560" MinHeight="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBr}"
                BorderThickness="1" Padding="18">
            <StackPanel>
                <TextBlock Text="OpsCoreControl" FontSize="25" FontWeight="Bold"/>
                <TextBlock x:Name="_versionText" Text="Версия 1.0.0" Margin="0,3,0,0" Opacity="0.75"/>
                <TextBlock Text="Инструменты системного администратора в одном окне"
                           Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="4,18,4,18">
            <TextBlock Text="О приложении" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="20"
                       Text="OpsCoreControl помогает управлять службами, процессами, автозагрузкой, сетью, дисками и параметрами Windows. Приложение разработано для системных администраторов и специалистов технической поддержки."/>
            <Grid Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Автор" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="rmUmind"/>
                <TextBlock Grid.Row="1" Text="Платформа" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Windows 10/11 · .NET Framework 4.7.2" Margin="0,7,0,0"/>
                <TextBlock Grid.Row="2" Text="Лицензия" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="MIT" Margin="0,7,0,0"/>
            </Grid>
        </StackPanel>

        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="Закрыть" Width="90" IsDefault="True" Click="_close_Click"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="GitHub" Click="_githubLink_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
