<Window x:Class="OpsCoreControl.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" Height="220" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}">
	<StackPanel Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
		<TextBlock Text="OpsCoreControl" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
		<TextBlock Text="Программу разработал rmUmind" Margin="0,12,0,0" HorizontalAlignment="Center"/>
		<TextBlock Margin="0,12,0,0" HorizontalAlignment="Center">
			<Hyperlink Click="_githubLink_Click">https://github.com/rmUmind</Hyperlink>
		</TextBlock>
	</StackPanel>
</Window>