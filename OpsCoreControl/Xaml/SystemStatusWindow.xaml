<Window x:Class="OpsCoreControl.SystemStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Полный дашборд" Width="920" Height="820" MinWidth="740" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="3,0,3,4">
            <TextBlock x:Name="_updatedText" DockPanel.Dock="Right" Text="Обновлено: —"
                       VerticalAlignment="Center" Opacity="0.75"/>
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="_autoUpdateCheckBox" Content="Обновлять автоматически" IsChecked="True"
                          VerticalAlignment="Center" Checked="_autoUpdateChanged" Unchecked="_autoUpdateChanged"/>
                <CheckBox x:Name="_topmostCheckBox" Content="Поверх остальных окон" Margin="18,0,0,0"
                          VerticalAlignment="Center" Checked="_topmostChanged" Unchecked="_topmostChanged"/>
                <Button Content="Обновить сейчас" Margin="18,0,0,0" Click="_refreshNow_Click"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Система">
                <StackPanel>
                    <TextBlock x:Name="_pcText" Text="ПК: —"/>
                    <TextBlock x:Name="_userText" Text="Пользователь: —"/>
                    <TextBlock x:Name="_uptimeText" Text="Uptime: —"/>
                    <TextBlock x:Name="_processText" Text="Процессов: —"/>
                    <TextBlock x:Name="_batteryText" Text="Батарея: —"/>
                    <TextBlock x:Name="_osText" Text="Windows: —" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Производительность">
                <StackPanel>
                    <TextBlock x:Name="_cpuText" Text="CPU: —"/>
                    <TextBlock Text="Оперативная память" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock x:Name="_ramUsedText" Text="Использовано: —"/>
                    <TextBlock x:Name="_ramFreeText" Text="Свободно: —"/>
                    <TextBlock x:Name="_ramTotalText" Text="Всего: —"/>
                    <TextBlock x:Name="_ramPercentText" Text="Загрузка: —"/>
                    <TextBlock x:Name="_virtualMemoryText" Text="Виртуальная память: —" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Сеть">
            <StackPanel>
                <TextBlock x:Name="_wifiText" Text="Wi-Fi: —"/>
                <TextBlock x:Name="_localIpText" Text="Локальный IP: —"/>
                <TextBlock x:Name="_publicIpText" Text="Публичный IP: —"/>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="1.5*"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="Диски">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="_diskActivityText" Text="Активность: —"/>
                    <ListBox Grid.Row="1" x:Name="_disksList" ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="_listPreviewMouseWheel"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="Файл подкачки">
                <ListBox x:Name="_pageFilesList" MinHeight="48" MaxHeight="90"
                         ScrollViewer.CanContentScroll="False" PreviewMouseWheel="_listPreviewMouseWheel"/>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="Сетевые адаптеры">
                <ListBox x:Name="_adaptersList" ScrollViewer.CanContentScroll="False"
                         PreviewMouseWheel="_listPreviewMouseWheel"/>
            </GroupBox>
            <GroupBox Grid.Row="3" Header="USB-устройства">
                <ListBox x:Name="_usbList" ScrollViewer.CanContentScroll="False"
                         PreviewMouseWheel="_listPreviewMouseWheel"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
