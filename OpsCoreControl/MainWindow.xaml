<Window x:Class="OpsCoreControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpsCoreControl"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" TabStripPlacement="Left">
            <TabItem Header="Sevices">
                <StackPanel HorizontalAlignment="Left">
                    <Button x:Name="_restartPrintSpoolerButton" Content="Reboot print spooler" Click="_restartPrintSpoolerButton_Click" Width="150" Height="50" />
                    <Button x:Name="_rebootPC" Content="Reboot" Click="_rebootPC_Click" Width="150" Height="50"/>
                    <Button x:Name="_shutdownPC" Content="Shutdown" Click="_shutdownPC_Click"  Width="150" Height="50"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Profile's">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="0">
                        <Button x:Name="_showUsersProfilesButton" Content="_showUsersProfiles" Click="_showUsersProfiles_ClickAsync" Width="150" Height="50"/>
                        <Button x:Name="_deleteProfileButton" Content="Delete Profile" Click="_deleteProfile_Click" Width="150" Height="50"/>
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Label x:Name="_userProfilesCountLabel" Grid.Row="0" Content="Count: " HorizontalAlignment="Right"/>
                        <ListBox x:Name="_usersProfilesListBox" Grid.Row="1" Width="300" SelectionMode ="Multiple" SelectionChanged="_usersProfilesListBox_SelectionChanged" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Folder's work">
                <Grid>
                    <StackPanel HorizontalAlignment="Left">
                        <Button x:Name="_cleanDownloadFolderButton" Content="_cleanDownloadFolder" Click="_cleanDownloadFolder_Click" Width="150" Height="50"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right">
                        <Button x:Name="_openNetworkPathButton" Content="_cleanDownloadFolder" Click="_openNetworkPathButton_Click" Width="150" Height="50"/>
                        <Label Content="Введите адрес папки"/>
                        <TextBox x:Name="_openNetworkPathTextBox"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Network">
                <StackPanel HorizontalAlignment="Left">
                    <Button x:Name="_clearNonRedeemablePoolButton" Content="Clean non redemable pool" Click="_clearNonRedeemablePool_Click" Width="150" Height="50"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Software">
                <Grid>
                    <StackPanel HorizontalAlignment="Left">
                        <Button x:Name="_downloadCryptoProButton" Content="Download CryptoPro" Click="_downloadCryptoPro_Click" Width="150" Height="50"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <Button x:Name="_tamplateButtonDesktopDirectroy" Content="Рабочий стол" Width="150" Height="50" Click="_tamplateButtonDesktopDirectroy_Click"/>
                        <Button x:Name="_tamplateButtonDownloadDirectory" Content="Загрузки" Width="150" Height="50" Click="_tamplateButtonDownloadDirectory_Click"/>
                        <Label Content="Укажите директорию для сохранения"/>
                        <TextBox x:Name="_downloadDirectoryTextBox"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="System settings">
                <Grid>
                    <StackPanel HorizontalAlignment="Left">
                        <Button x:Name="_setScreenLockTimerButton" Content="_setScreenLockTimer" Click="_setScreenLockTimerButton_Click" Height="50" Width="150"/>
                        <Label Content="Введи время в минутах"/>
                        <TextBox x:Name="_timeToScreenLockTimerTextBox"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right">
                        <Label Content="Только для ноутбуков"/>
                        <Button x:Name="_setMonitorBrightnessButton" Content="Установить яркость монитора (ноутубуки)" Click="_setMonitorBrightnessButton_Click" Height="50" Width="150"/>
                        <Label Content="Введи значение яркости"/>
                        <TextBox x:Name="_setMonitorBrightnessTextBox" Text="100"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Orientation="Horizontal">
            <ListBox x:Name="_mainChatListBox" Width="400" Height="100" HorizontalAlignment="Right" ScrollViewer.CanContentScroll="True"/>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Loaded Ram:"/>
                    <Label x:Name="_ramLoadLabel" Content="Getting ram data"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Loaded VRam:"/>
                    <Label x:Name="_virtualRamLoadLabel" Content="Getting ram data"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="CP usege:"/>
                    <Label  x:Name="_cpLoadLabel" Content="Getting CP data"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Free space:"/>
                    <Label x:Name="_freeSpaceLabel" Content="Getting free space data"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
